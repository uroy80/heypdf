# /etc/heypdf/heypdf.env — settings for the heypdf stack on this server (root:heypdf-deploy, mode 0640). Never in git.
# heypdf-deploy passes it to docker compose as the first --env-file; values sent by CI (PROD_ENV secret, HEYP_* keys
# only, never the network/firewall keys) and the release tag override it. Changes apply on the next deploy; to apply
# them now, redeploy the running release (--keep-ci-env keeps the values CI sent last time):
#   sudo -u heypdf-deploy /usr/local/sbin/heypdf-deploy deploy "$(cat /srv/heypdf/state/current)" --keep-ci-env
# Apache + Cloudflare server (heypdf.edgr.in): start from heypdf.env.edgr.example instead (deploy/DEPLOY.md §8).

# --- public address (DNS A/AAAA records must point at this VPS) ----------------------------------------------
HEYP_DOMAIN=heypdf.example.com
# Defaults to https://HEYP_DOMAIN; set it only if the public URL differs (e.g. a non-standard port).
#HEYP_PUBLIC_URL=https://heypdf.example.com
# heyp, the photo toolbox, when you run it too: the "heyp · heypdf" switch in the masthead links there.
# "off" (the default) shows no switch.
#HEYP_SIBLING_URL=https://heyp.example.com

# --- which optional services run --------------------------------------------------------------------------
#   docs     Office <-> PDF conversions, OCR, compression, PDF/A (no network access at all)
#   render   HTML -> PDF (renderer + egress proxy; optional host guard: bootstrap-vps.sh --egress-guard)
COMPOSE_PROFILES=docs,render

# --- the reverse proxy on the host (deploy/apache/) connects to the app on 127.0.0.1:${HEYP_PORT} ----------------
# Pick a port nothing else on the server uses, and use the same number in the proxy's configuration.
HEYP_PORT=8181

# --- operator: shown on /privacy and /terms (required; the app refuses hosted mode without name + e-mail) ---
HEYP_OPERATOR_NAME=
HEYP_OPERATOR_EMAIL=
# Country you operate from (defaults to HEYP_JURISDICTION) and the law that governs the terms.
#HEYP_OPERATOR_COUNTRY=India
HEYP_JURISDICTION=India
# India IT Rules: named grievance officer (defaults to the operator).
#HEYP_GRIEVANCE_OFFICER=
#HEYP_POSTAL_ADDRESS=
# Date the current policy took effect (YYYY-MM-DD). Change it whenever legal/*.md changes in a way that matters.
HEYP_EFFECTIVE_DATE=
# Where the VPS is (hPanel → VPS → Overview), e.g. "Lithuania (EU)" or "India". Shown in "Where your data goes".
HEYP_SERVER_LOCATION=
HEYP_HOSTING_PROVIDER=Hostinger
# A CDN / proxy service in front of the server that terminates HTTPS (e.g. Cloudflare's orange-cloud proxy) sees every
# upload and result in transit: name it here and /privacy and /terms list it as a service provider. Behind Cloudflare:
#   HEYP_CDN_PROVIDER=Cloudflare
#   HEYP_CDN_DPA_URL=https://www.cloudflare.com/cloudflare-customer-dpa/
#HEYP_CDN_PROVIDER=
#HEYP_CDN_DPA_URL=
# Optional: GDPR Art. 27 representatives, DMCA agent, separate inboxes, liability cap wording.
#HEYP_EU_REPRESENTATIVE=
#HEYP_UK_REPRESENTATIVE=
#HEYP_DMCA_AGENT=
#HEYP_SECURITY_EMAIL=
#HEYP_ABUSE_EMAIL=
#HEYP_LIABILITY_CAP=

# --- logs and the privacy policy: these numbers are printed on /privacy, so they must match reality ----------
# How long the proxy keeps its access log (Apache: deploy/apache/logrotate-heypdf).
HEYP_LOG_RETENTION_DAYS=14
# Hostinger's automatic weekly VPS backups keep 2 copies (~14 days); 0 if you turned backups off.
HEYP_BACKUP_RETENTION_DAYS=14
# 1 only if your proxy logs shortened IPs.
HEYP_LOG_IP_TRUNCATED=0

# --- files ------------------------------------------------------------------------------------------------
HEYP_TTL_MINUTES=60
HEYP_HARD_TTL_MINUTES=240
HEYP_MAX_UPLOAD_MB=100
HEYP_MAX_FILES=50
HEYP_MAX_PIXELS=50000000
# Largest upload request in MiB (empty = automatic, 257). Behind a CDN, set it under the CDN's request cap (Cloudflare:
# 95, with HEYP_MAX_UPLOAD_MB <= 94): the UI then splits uploads into requests of that size.
#HEYP_MAX_REQUEST_MB=95

# --- optional AI tools (Summarize / Translate PDF via Anthropic's API) ----------------------------------------
# Prefer sending the key from GitHub (PROD_ENV secret line HEYP_ANTHROPIC_API_KEY=…) over storing it here. Deleting
# that line (or the whole secret) and redeploying turns the AI tools off and removes the key from the server.
#HEYP_ANTHROPIC_API_KEY=
HEYP_AI_INFERENCE_GEO=us
HEYP_AI_DAILY_USD=10.00
HEYP_AI_REQUEST_USD=1.00
# Optional (defaults shown): HEYP_AI_MODEL=claude-opus-5-5 · HEYP_AI_MAX_PAGES=100 (only these two and the three
# above reach the container through compose.prod.yml; add others there if you need them).
# The app also reads HEYP_AI_ENABLED (kill switch), ANTHROPIC_API_KEY_FILE, HEYP_AI_MODEL_FAST, HEYP_AI_FALLBACKS,
# HEYP_AI_PRICES, HEYP_AI_TIMEOUT_S, HEYP_AI_MAX_RETRIES, HEYP_AI_CONCURRENCY (see app/ai/config.py).

# --- HTML to PDF (render profile) -------------------------------------------------------------------------
# Filled in by bootstrap-vps.sh: this server's public IPs (comma-separated CIDRs), which the egress proxy refuses —
# otherwise a captured page could reach other sites and admin panels on this VPS. Add every public IP the VPS has.
HEYP_EGRESS_DENY_CIDRS=
# Shared secret between the renderer and the egress proxy (bootstrap-vps.sh generates one: openssl rand -hex 32).
HEYP_EGRESS_SECRET=

# --- capacity (ceilings, not reservations) -----------------------------------------------------------------------
# app 2.5 GB (its RAM /tmp with the uploads counts here), docs 1.25 GB, renderer 1 GB, egress 128 MB.
HEYP_MEM_LIMIT=2560m
HEYP_TMP_SIZE=768m
HEYP_CPUS=1.5
HEYP_CACHE_MB=256
HEYP_LANE_LIGHT=2
HEYP_LANE_HEAVY=1
HEYP_DOCS_MEM_LIMIT=1280m
HEYP_DOCS_CPUS=1.0
HEYP_RENDERER_MEM_LIMIT=1g
HEYP_RENDERER_CPUS=1.0

# --- networks (change only if they collide with existing Docker networks) -------------------------------------
# The edge network's subnet is also the default HEYP_TRUSTED_PROXIES; the egress subnet is what the guard matches.
#HEYP_EDGE_SUBNET=172.31.253.0/24
#HEYP_EGRESS_SUBNET=172.31.254.0/24
#HEYP_DOCS_SUBNET=172.31.255.0/24
#HEYP_RENDER_SUBNET=172.31.250.0/24
