# /etc/heypdf/heypdf.env for the edgr server: heypdf at https://heypdf.edgr.in (heyp, at https://heyp.edgr.in, is a
# separate stack on the same server). AlmaLinux 10.1 · 4 vCPU / 15 GB · Docker ≥ 28 · Apache httpd owns 80/443 for
# every site (edgr.in → :3000, klipo.club → :8100, heyp.edgr.in → :8180) · Cloudflare proxies the names, with a
# Cloudflare Origin certificate on Apache.
#
#   sudo bash /tmp/heypdf/deploy/bootstrap-vps.sh --ci-key "ssh-ed25519 AAAA… heypdf-ci" --egress-guard \
#        --env-template heypdf.env.edgr.example
#
# copies this file to /etc/heypdf/heypdf.env (root:heypdf-deploy, 0640) and fills in HEYP_EGRESS_DENY_CIDRS /
# HEYP_EGRESS_SECRET. The Apache side is deploy/apache/ (deploy/DEPLOY.md §8). Every other setting: heypdf.env.example.
# Apply changes:
#   sudo -u heypdf-deploy /usr/local/sbin/heypdf-deploy deploy "$(cat /srv/heypdf/state/current)" --keep-ci-env

# --- public address ------------------------------------------------------------------------------------------------
HEYP_DOMAIN=heypdf.edgr.in
# The "heyp · heypdf" switch: heyp, the photo toolbox, on its own name (a plain link; files never move across).
HEYP_SIBLING_URL=https://heyp.edgr.in

# --- Apache proxies to the app on the loopback port below -------------------------------------------------------
COMPOSE_PROFILES=docs,render
HEYP_BIND=127.0.0.1
# Must equal "Define HEYPDF_PORT" in deploy/apache/ssl-heypdf.conf. Taken on this server: 3000, 3100, 4416, 8100,
# 8180 (heyp), 65529.
HEYP_PORT=8181
# HEYP_TRUSTED_PROXIES stays at its default (the edge network): Apache's connections to the published loopback port
# reach the app from that network's gateway. Apache itself turns CF-Connecting-IP into the visitor's address.

# --- operator, shown on /privacy and /terms -----------------------------------------------------------------------
HEYP_OPERATOR_NAME="Usham Roy"
HEYP_OPERATOR_EMAIL=support@edgr.in
HEYP_GRIEVANCE_OFFICER="Usham Roy"
HEYP_OPERATOR_COUNTRY=India
HEYP_JURISDICTION=India
# The launch date (YYYY-MM-DD); change it whenever legal/*.md changes in a way that matters.
HEYP_EFFECTIVE_DATE=
# hPanel → VPS → Overview, e.g. "India" or "Lithuania (EU)".
HEYP_SERVER_LOCATION=
HEYP_HOSTING_PROVIDER=Hostinger
# Cloudflare terminates HTTPS for this name and so carries every upload and result: /privacy and /terms name it.
HEYP_CDN_PROVIDER=Cloudflare
HEYP_CDN_DPA_URL=https://www.cloudflare.com/cloudflare-customer-dpa/

# --- logs (printed on /privacy; Apache keeps them as deploy/apache/logrotate-heypdf says) -----------------------------
HEYP_LOG_RETENTION_DAYS=14
# Hostinger's automatic weekly VPS backups keep 2 copies (~14 days); 0 if they are off.
HEYP_BACKUP_RETENTION_DAYS=14
HEYP_LOG_IP_TRUNCATED=0

# --- files: Cloudflare accepts at most 100 MB per request, so one file stays below it ----------------------------------
HEYP_TTL_MINUTES=60
HEYP_HARD_TTL_MINUTES=240
HEYP_MAX_UPLOAD_MB=90
# One upload request stays under Cloudflare's cap too: the server refuses bigger ones and the UI batches to it.
HEYP_MAX_REQUEST_MB=95
HEYP_MAX_FILES=50
HEYP_MAX_PIXELS=50000000

# --- optional AI tools: the key comes from the PROD_ENV secret (HEYP_ANTHROPIC_API_KEY=…), never from this file -------
HEYP_AI_INFERENCE_GEO=us
HEYP_AI_DAILY_USD=10.00
HEYP_AI_REQUEST_USD=1.00

# --- HTML to PDF: filled in by bootstrap-vps.sh (this server's public IPs, e.g. 147.93.18.165/32) -------------------
HEYP_EGRESS_DENY_CIDRS=
HEYP_EGRESS_SECRET=

# --- capacity: 4 vCPU / 15 GB shared with heyp and the other sites --------------------------------------------------
# Ceilings, not reservations: app 3 GB (its RAM /tmp with the uploads counts here), docs 2 GB, renderer 1 GB,
# egress 128 MB ≈ 6.1 GB — with heyp's stack (≈ 4.6 GB) and the other sites (≈ 4 GB) under 15 GB. No container may
# take all 4 CPUs.
HEYP_MEM_LIMIT=3g
HEYP_TMP_SIZE=1g
HEYP_CPUS=2
HEYP_CACHE_MB=256
HEYP_LANE_LIGHT=3
HEYP_LANE_HEAVY=2
HEYP_DOCS_MEM_LIMIT=2g
HEYP_DOCS_CPUS=1.5
HEYP_RENDERER_MEM_LIMIT=1g
HEYP_RENDERER_CPUS=1.5

# --- networks: change only if `docker network inspect` shows another network on these subnets ----------------------
#HEYP_EDGE_SUBNET=172.31.253.0/24
#HEYP_EGRESS_SUBNET=172.31.254.0/24
#HEYP_DOCS_SUBNET=172.31.255.0/24
#HEYP_RENDER_SUBNET=172.31.250.0/24
