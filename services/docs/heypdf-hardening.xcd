<?xml version="1.0" encoding="UTF-8"?>
<!-- heypdf-docs LibreOffice policy. Installed as a system registry layer; every value is finalized, so no document
     or user profile can override it. Goal: a converted document can never run code or pull in anything that is
     not inside the document itself (no macros, no OLE/DDE/active content, no linked files or URLs). -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
 <dependency file="main"/>
 <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Security">
   <node oor:name="Scripting">
    <!-- 3 = "very high": only macros from trusted locations, and there are none -->
    <prop oor:name="MacroSecurityLevel" oor:finalized="true"><value>3</value></prop>
    <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
    <!-- links to images/sections outside the document are not followed -->
    <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true"><value>true</value></prop>
    <!-- OLE objects, DDE fields, applets, plug-ins -->
    <prop oor:name="DisableActiveContent" oor:finalized="true"><value>true</value></prop>
   </node>
  </node>
 </oor:component-data>
 <!-- Never update links while loading (Writer: 0 always / 1 on request / 2 never). -->
 <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
  <node oor:name="Content"><node oor:name="Update"><prop oor:name="Link" oor:finalized="true"><value>2</value></prop></node></node>
 </oor:component-data>
 <!-- Calc uses its own enum (0 always / 1 never / 2 on request). -->
 <oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
  <node oor:name="Content"><node oor:name="Update"><prop oor:name="Link" oor:finalized="true"><value>1</value></prop></node></node>
 </oor:component-data>
</oor:data>
